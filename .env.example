# 公開URL（OG・canonical・sitemap・メール内リンク・サインアップの emailRedirectTo の正規化）
# - 本番では Site URL / Redirect URLs と **同一のオリジン** にする（apex と www を混在させないのが最も安全）。
#   例: NEXT_PUBLIC_SITE_URL=https://viewtrace.net なら、Supabase の Site URL も https://viewtrace.net
# - ユーザーが www でもアクセスする場合は、Redirect URLs に **両方** 足す:
#     https://viewtrace.net/auth/callback
#     https://www.viewtrace.net/auth/callback
#   （コード上の候補は src/lib/auth/callback-url.ts の authCallbackUrlsForSupabaseAllowlist）
# - ローカル: http://localhost:3000（ポートに合わせる）
# - 未設定時のフォールバックは https://viewtrace.net
# - ドメインだけ（viewtrace.net）でも https に正規化されるが、https:// 付きを推奨
NEXT_PUBLIC_SITE_URL=https://viewtrace.net
# （任意）Cron が送る「記録を開く」リンクのオリジン。未設定時は siteOrigin と同じ。
# NEXT_PUBLIC のビルド時インラインと食い違うプレビュー等で 404 になる場合に設定。
# VIEWTRACE_PUBLIC_APP_ORIGIN=https://viewtrace.net

# SEO（環境変数ではなくリポジトリで管理）:
# - 既定の meta keywords: src/lib/seo/site-keywords.ts → app/layout.tsx の metadata.keywords
# - 検索意図トピック: src/lib/seo/topic-pages.ts の本文をトップ LP の #search-topics にインライン表示（別 /topics ルートなし）
# - sitemap / robots: src/app/sitemap.ts, src/app/robots.ts

# Supabase（Dashboard → Project Settings → API）
# anon / public キーはフロントに載る前提。service_role は絶対に NEXT_PUBLIC にしないこと。
# 末尾に /rest/v1/ を付けない（プロジェクトルートのみ）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# （任意）getSession が null になったときの「セッション Cookie 無し」ログを開発で出す: VIEWTRACE_AUTH_DEBUG_GET_SESSION=1
# 監査ログ: public.audit_events（supabase/migrations/20260509120000_audit_events.sql を適用）

# Authentication（確認メールを届ける・リンクを有効にする）:
# - Dashboard → Authentication → URL configuration
#     Site URL: NEXT_PUBLIC_SITE_URL と同じオリジン（末尾スラッシュなし）。
#     Redirect URLs（例・本番 viewtrace.net の場合は両方）:
#       https://viewtrace.net/auth/callback
#       https://www.viewtrace.net/auth/callback
#     ローカル: http://localhost:3000/auth/callback（ポートに合わせる）
#     Vercel プレビュー: 必要なら https://*.vercel.app/auth/callback（Supabase のワイルドカード規則に従う）
# - Email Templates → Confirm signup: token_hash 方式（別ブラウザでも確認可）
#     本文ソース: supabase/templates/confirmation-body.html
#     反映コマンド: npm run sync:supabase-confirmation-email
#       要 SUPABASE_ACCESS_TOKEN (https://supabase.com/dashboard/account/tokens)
#       要 SUPABASE_PROJECT_REF または NEXT_PUBLIC_SUPABASE_URL から自動推定
#     {{ .ConfirmationURL }} のみだと PKCE の code verifier エラーになりやすい。
#     同期用（Account → Access Tokens。anon / service_role とは別）:
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=  # 省略可（NEXT_PUBLIC_SUPABASE_URL の xxx 部分）
# - Confirm email をオンにした場合、サインアップ後に Supabase から確認メールが送られる
# - 届かない場合: Project Settings → Auth → SMTP で Resend 等を設定するか、迷惑メールフォルダを確認
# - ローカルですぐ試す場合は「Confirm email」をオフにできる

# （任意）メールのみのリード取得: trial_signups マイグレーション + POST /api/trial-signup。LP の主導線は /login でのアカウント作成。

# Resend（https://resend.com/api-keys）
# RESEND_API_KEY=re_xxxx
# 送信元（自ドメインを Resend で検証後、例: Viewtrace <info@viewtrace.net>）
# RESEND_FROM=Viewtrace <info@viewtrace.net>
# POST /api/resend/send 用の共有シークレット（Bearer と完全一致させる長いランダム文字列）
# RESEND_SEND_SECRET=

# Admin tools（SQL Editor など）
# 管理者にするメールアドレスをカンマ区切りで指定
# ADMIN_EMAILS=you@example.com,other@example.com
#
# Supabase の Postgres 接続URL（Service Role ではなく DB 直結）
# Settings → Database → Connection string の URI を貼り付け
# 例: postgres://postgres:password@db.xxxxxx.supabase.co:6543/postgres
# SUPABASE_DB_URL=

# Stripe（https://dashboard.stripe.com/apikeys）
# STRIPE_SECRET_KEY=sk_test_...
# Starter / Pro の「月額サブスクリプション」用 Price ID（Products → Prices）
# STRIPE_PRICE_ID_STARTER=price_...
# STRIPE_PRICE_ID_PRO=price_...
# Webhook signing secret（Developers → Webhooks → エンドポイント）
# STRIPE_WEBHOOK_SECRET=whsec_...

# 枠超過時の従量単価（USD / 回）。LP・料金表・FAQ・ダッシュボードに表示する。未設定・空だと従量の金額は出さない。
# NEXT_PUBLIC_OVERAGE_PER_OBSERVATION_USD=0.75

# 地域別観測（HTTP fetch および POST /api/screenshot 経由の Browserless）
# Browserless にはクエリ externalProxyServer として渡す（公式: Proxies / external proxy）
# 固定URL: VIEWTRACE_GEO_PROXY_URL=http://user:pass@host:port
# Bright Data（ダッシュボードの curl と同等）の例（値は伏せて .env.local にのみ記載）:
# VIEWTRACE_GEO_PROXY_URL=http://brd-customer-XXXX-zone-ZZZONE:ZONE_PASSWORD@brd.superproxy.io:33335
# プロキシ経由で TLS 検証エラーになるとき: プロバイダの PEM を環境変数に入れる（Vercel の Env にそのまま貼れる）
# VIEWTRACE_GEO_PROXY_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# テンプレ（国・州ごとにユーザー名が変わるプロバイダ向け）: US-CA → country=US state=CA / GB 等 → state は空
# VIEWTRACE_GEO_PROXY_URL_TEMPLATE=http://user-country-{country}-state-{state}:PASS@proxy.example.com:10000

# Browserless（スクリーンショット API のラップ: POST /api/screenshot）
# 上記 GEO プロキシを設定すると、自動で externalProxyServer に載せる（テンプレ時は JSON に region 必須）
# Browserless の無料枠では外部プロキシが 401 になる場合がある（プラン要確認）
# BROWSERLESS_TOKEN=
# 省略時は https://production-sfo.browserless.io/screenshot
# BROWSERLESS_SCREENSHOT_URL=https://production-sfo.browserless.io/screenshot
# curl 等でセッションなしで叩くとき（長いランダム文字列を推奨）
# VIEWTRACE_SCREENSHOT_SECRET=

# --- Ops monitoring（/api/cron/ops-monitoring・vercel.json は Hobby 向けに 1 日 1 回。Pro なら `*/15 * * * *` 可）---
# DB メトリクスは SUPABASE_DB_URL（または DATABASE_URL）があるときのみ取得可能。
# 通知先（未設定時は info@viewtrace.net）
# OPS_ALERT_EMAIL=info@viewtrace.net
# OPS_ALERT_EMAILS=ops@example.com,oncall@example.com
# ミドルウェア→内部 API 用（未設定時は CRON_SECRET を流用可。本番は専用の長い乱数推奨）
# OPS_SIGNAL_ROUTE_SECRET=
# 無効化
# OPS_MONITORING_DISABLED=1
# しきい値（任意）: OPS_DB_CONN_WARN, OPS_DB_CONN_CRITICAL, OPS_STORAGE_GROWTH_RATIO,
# OPS_SERVER_ERROR_WINDOW_MINUTES, OPS_SERVER_ERROR_COUNT_WARN, OPS_AUTH_FAIL_WINDOW_MINUTES,
# OPS_AUTH_FAIL_COUNT_WARN, OPS_SUSPICIOUS_WINDOW_MINUTES, OPS_SUSPICIOUS_COUNT_WARN,
# OPS_SELF_LATENCY_WARN_MS, OPS_ALERT_COOLDOWN_MINUTES, OPS_MIN_PRIOR_DB_BYTES

# Vercel Blob（Browserless の PNG を公開 URL で保存 → DB の snapshot_image_url に記録）
# Dashboard → Storage → Create Blob store。本番では必ず設定することを推奨。
# 未設定時はアップロードをスキップし snapshot_image_url は null のまま（フォールバックで OG / Microlink 画像になる場合あり）
# BLOB_READ_WRITE_TOKEN=
